exec gofumpt -w foo.go
cmp foo.go foo.go.golden

exec gofumpt -d foo.go.golden
! stdout .

exec gofumpt -w empty-comments.go
cmp empty-comments.go empty-comments.go.golden

exec gofumpt -d empty-comments.go.golden
! stdout .

exec gofumpt -w empty-docs.go
cmp empty-docs.go empty-docs.go.golden

exec gofumpt -d empty-docs.go.golden
! stdout .

-- foo.go --
