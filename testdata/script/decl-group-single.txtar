# TODO: joining lone imports puts the group's closing parenthesis on the line of
# the last import, as there is no line of its own for it. Moving a std import up
# then drops that line, which pulls a comment on the line below into the group's
# line, as the golden file for f7.go shows. The comment should stay put.
exec gofumpt -w f1.go f2.go f3.go f4.go f5.go f6.go f7.go
cmp f1.go f1.go.golden
cmp f2.go f2.go.golden
cmp f3.go f3.go.golden
cmp f4.go f4.go.golden
cmp f5.go f5.go.golden
cmp f6.go f6.go.golden
cmp f7.go f7.go.golden

exec gofumpt -d f1.go.golden f2.go.golden f3.go.golden f4.go.golden f5.go.golden f6.go.golden f7.go.golden
! stdout .

-- f1.go --
package p

import "non-grouped"

import (
	"grouped"
)

var single = "foo"

var (
	// verbose is verbose.
	verbose = "bar"
)

// This entire block has a comment.
var (
	groupComment = "bar"
)

var (
	multiple1 string
	multiple2 string
)

const (
	first = iota
)

var (
	multiline = []string{
		"foo",
		"bar",
	}
)

var (
	foo = "foo"
	// bar = "bar"
	// baz = "baz"
)
-- f1.go.golden --
package p

import "non-grouped"

import (
	"grouped"
)

var single = "foo"

// verbose is verbose.
var verbose = "bar"

// This entire block has a comment.
var (
	groupComment = "bar"
)

var (
	multiple1 string
	multiple2 string
)

const (
	first = iota
)

var multiline = []string{
	"foo",
	"bar",
}

var foo = "foo"

// bar = "bar"
// baz = "baz"
-- f2.go --
package p

func _() {
	var (
		_ int
	)
}
-- f2.go.golden --
package p

func _() {
	var _ int
}
-- f3.go --
package p

import "strings"
import "bytes"

var _ = bytes.Buffer{}
var _ = strings.Builder{}
-- f3.go.golden --
package p

import (
	"bytes"
	"strings"
)

var (
	_ = bytes.Buffer{}
	_ = strings.Builder{}
)
-- f4.go --
package p

var A = 1
var (
	B = 2
)

var (
	C = 3
)
var D = 4
-- f4.go.golden --
package p

var (
	A = 1
	B = 2
)

var (
	C = 3
	D = 4
)
-- f5.go --
package p

var msgTypes = make([]int, 6)
var goTypes = []interface{}{
	(*int)(nil),
}
var depIdxs = []int32{
	6,
}
-- f5.go.golden --
package p

var (
	msgTypes = make([]int, 6)
	goTypes  = []interface{}{
		(*int)(nil),
	}
)

var depIdxs = []int32{
	6,
}
-- f6.go --
package p

import "os" // this comment documents the import of "os"
import "github.com/x/y"

import "bytes" // sorted already, so joining moves no import
import "context"

import "strings" // a raw quoted path sorts by its unquoted value
import `sort`

import zz "path" // imports of the same path are not joined
import aa "path"

import _ "io"
import _ "errors" // a comment on the last import counts as well
-- f6.go.golden --
package p

import "os" // this comment documents the import of "os"
import "github.com/x/y"

import (
	"bytes" // sorted already, so joining moves no import
	"context"
)

import "strings" // a raw quoted path sorts by its unquoted value
import "sort"

import zz "path" // imports of the same path are not joined
import aa "path"

import _ "io"
import _ "errors" // a comment on the last import counts as well
-- f7.go --
package p

import "os"
import "github.com/x/y"
// this comment stands on its own line after the imports
-- f7.go.golden --
package p

import (
	"os"

	"github.com/x/y"
) // this comment stands on its own line after the imports
