exec gofumpt -w foo.go
cmp foo.go foo.go.golden

exec gofumpt -d foo.go.golden
! stdout .

exec gofumpt -w commented-types.go
cmp commented-types.go commented-types.go.golden

exec gofumpt -d commented-types.go.golden
! stdout .

# TODO: go/printer only keeps a one-line struct or interface type on one line
# if it has a single small field without a tag, so a signature which is on one
# line in the source gets its closing parenthesis on a line of its own only on
# a second run.
exec gofumpt -w one-line-types.go
cmp one-line-types.go one-line-types.go.golden

! exec gofumpt -d one-line-types.go.golden
stdout .

-- foo.go --
package p

func f1() {

	println("multiple")

	println("statements")

}

func f2() {

	// comment directly before
	println()

	// comment after

