-- one-line-types.go --
package p

func twoFields(a struct{ x int; y int }, b int) {
	println("body")
}

func taggedField(a struct{ x int `json:"x"` }, b int) {
	println("body")
}

func longField(a struct{ x map[string]map[string]map[string]int }, b int) {
	println("body")
}

func twoMethods(a interface{ M(); N() }) {
	println("body")
}

func nestedTwoFields(a struct{ x struct{ y int; z int } }, b int) {
	println("body")
}

func shortField(a struct{ x, y int }, b int) {
	println("body")
}
-- one-line-types.go.golden --
package p

func twoFields(a struct {
	x int
	y int
}, b int) {
	println("body")
}

func taggedField(a struct {
	x int `json:"x"`
}, b int) {
	println("body")
}

func longField(a struct {
	x map[string]map[string]map[string]int
}, b int) {
	println("body")
}

func twoMethods(a interface {
	M()
	N()
}) {
	println("body")
}

func nestedTwoFields(a struct {
	x struct {
		y int
		z int
	}
}, b int) {
	println("body")
}

func shortField(a struct{ x, y int }, b int) {
	println("body")
}
