-- commented-types.go --
package p

func emptyStruct(a struct { /* comment */ }, b int) {
	println("body")
}

func emptyInterface(a interface { /* comment */ }) {
	println("body")
}

func structWithField(a struct{ x int /* comment */ }, b int) {
	println("body")
}

func results() (struct { /* comment */ }, int) {
	panic("body")
}
