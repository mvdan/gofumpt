exec gofumpt -w foo.go
cmp foo.go foo.go.golden

exec gofumpt -d foo.go.golden
! stdout .

exec gofumpt -w doc.go
cmp doc.go doc.go.golden

exec gofumpt -d doc.go.golden
! stdout .

exec gofumpt -w build-doc.go
cmp build-doc.go build-doc.go.golden

exec gofumpt -d build-doc.go.golden
! stdout .

exec gofumpt -w build-func.go
cmp build-func.go build-func.go.golden

exec gofumpt -d build-func.go.golden
! stdout .

exec gofumpt -w build-plus.go
cmp build-plus.go build-plus.go.golden

exec gofumpt -d build-plus.go.golden
! stdout .

exec gofumpt -w build-between.go
cmp build-between.go build-between.go.golden

exec gofumpt -d build-between.go.golden
! stdout .

