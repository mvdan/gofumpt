exec gofumpt -w foo.go
cmp foo.go foo.go.golden

exec gofumpt -d foo.go.golden
! stdout .

exec gofumpt -w header.go
cmp header.go header.go.golden

exec gofumpt -d header.go.golden
! stdout .

exec gofumpt -w types.go
cmp types.go types.go.golden

exec gofumpt -d types.go.golden
! stdout .

exec gofumpt -w parens.go
cmp parens.go parens.go.golden

exec gofumpt -d parens.go.golden
! stdout .

exec gofumpt -w bodies.go
cmp bodies.go bodies.go.golden

exec gofumpt -d bodies.go.golden
! stdout .

-- foo.go --
package p

func f1() { println("single line") }
func f2() { println("single line") }

func f3() {
	println("multiline")
}
func f4() {
	println("multiline")
}

func (v *OffsetForLeaderEpochResponse) Throttle() (int32, bool) { return v.ThrottleMillis, v.Version >= 0 }
func (v *OffsetForLeaderEpochResponse) RequestKind() Request { return &OffsetForLeaderEpochRequest{Version: v.Version} }

// l1 is a var.
var l1 = []int{
	1, 2,
}
// l2 is a var.
var l2 = []int{
	3, 4,
}

var (
	s3 = `
		ok if grouped together
	`
	s4 = `
		ok if grouped together
	`
)
var _ = "ok if either isn't multiline"

var (
	v1 = []int{
		1,
	}
) // trailing comment
var v2 = []int{
	2,
}
-- foo.go.golden --
package p

func f1() { println("single line") }
func f2() { println("single line") }

func f3() {
	println("multiline")
}

func f4() {
	println("multiline")
}

func (v *OffsetForLeaderEpochResponse) Throttle() (int32, bool) {
	return v.ThrottleMillis, v.Version >= 0
}

func (v *OffsetForLeaderEpochResponse) RequestKind() Request {
	return &OffsetForLeaderEpochRequest{Version: v.Version}
}

// l1 is a var.
var l1 = []int{
	1, 2,
}

// l2 is a var.
var l2 = []int{
	3, 4,
}

var (
	s3 = `
		ok if grouped together
	`
	s4 = `
		ok if grouped together
	`
)
var _ = "ok if either isn't multiline"

var v1 = []int{
	1,
} // trailing comment

var v2 = []int{
	2,
}
-- header.go --
// Copyright notice.

// Package p is a package.
package p

func h1() { println("single line") }
func h2() {
	println("multiline")
}
-- header.go.golden --
// Copyright notice.

// Package p is a package.
package p

func h1() { println("single line") }
func h2() {
	println("multiline")
}
-- types.go --
package p

type A struct {
	x int
}
type B interface {
	M()
}

type C int
type D struct {
	x int
}
type E int
type F int
-- types.go.golden --
package p

type A struct {
	x int
}

type B interface {
	M()
}

type (
	C int
	D struct {
		x int
	}
)

type (
	E int
	F int
)
-- parens.go --
package p

import ("fmt")
import ("os")

const (A = 1)
const (B = 2)

type (C int)
type (D int)
-- parens.go.golden --
package p

import (
	"fmt"
)

import (
	"os"
)

const (
	A = 1
)

const (
	B = 2
)

type (
	C int
)

type (
	D int
)
-- bodies.go --
package p

func switch1() { switch {} }
func switch2() { switch {} }

func if1() { if true {} }
func if2() { if true {} }

func short()                         { println("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa") }
func longerNameAlignedWithShort()    { println("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa") }
func evenLongerNameAlignedWithShort() { println("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa") }

func multi1() {
	println()
}
func longComment() { /* cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc */ }
func multi2() {
	println()
}
var lineComment = 1 // c
func multi3() {
	println()
}
-- bodies.go.golden --
package p

func switch1() {
	switch {
	}
}

func switch2() {
	switch {
	}
}

func if1() {
	if true {
	}
}

func if2() {
	if true {
	}
}

func short()                          { println("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa") }
func longerNameAlignedWithShort()     { println("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa") }
func evenLongerNameAlignedWithShort() { println("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa") }

func multi1() {
	println()
}

func longComment() { /* cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc */
}

func multi2() {
	println()
}

var lineComment = 1 // c
func multi3() {
	println()
}
